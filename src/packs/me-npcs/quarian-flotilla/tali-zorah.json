  "system": {
    "slug": "tali-zorah",
    "details": {
      "level": {
        "value": 10
      },
      "publicNotes": "<p>Tali'Zorah vas Normandy is a quarian engineer and one of Shepard's most trusted companions. Brilliant with technology and synthetic systems, she can hack, disable, or reprogram virtually any device or platform. She wears an environmental suit at all times due to quarian immune system fragility.</p><p><strong>Combat Drone (2 actions):</strong> Tali deploys a drone (AC 16, HP 25) that distracts one enemy within 60 feet, imposing a –2 circumstance penalty to that enemy's attack rolls while it remains active.</p><p><strong>AI Hacking (3 actions, 1/encounter):</strong> One synthetic creature within 60 feet must succeed on a DC 28 Will save or become Confused for 1 round.</p><p><strong>Kinetic Barrier:</strong> 50 Shield HP. Recharges 15 HP per turn.</p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
        "license": "ORC",
        "remaster": true
      },
      "languages": {
        "value": [],
        "details": ""
      },
      "blurb": "Quarian engineer and hacker; peerless with technology and synthetic systems, deadly with a shotgun."
