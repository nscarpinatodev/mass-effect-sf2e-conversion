  "system": {
    "slug": "admiral-hackett",
    "details": {
      "level": {
        "value": 12
      },
      "publicNotes": "<p>Admiral Steven Hackett commands the Alliance Fifth Fleet and serves as one of humanity's most senior military officers. Rarely found in direct combat, he is nonetheless a formidable presence whose strategic acumen and personal authority make every soldier under his command fight harder. When circumstances force him into the field, he proves that admirals do not reach his rank by accident.</p><p><strong>Fleet Command (aura, 60 ft):</strong> Alliance allies within 60 feet gain a +2 morale bonus to saving throws.</p><p><strong>Strategic Directive (2 actions, 1/encounter):</strong> Up to three allies within 60 feet may each immediately Stride or Strike as a free action.</p><p><strong>Kinetic Barrier:</strong> 30 Shield HP. Recharges 10 HP per turn.</p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
        "license": "ORC",
        "remaster": true
      },
