  "system": {
    "slug": "ambassador-udina",
    "details": {
      "level": {
        "value": 5
      },
      "publicNotes": "<p>Donnel Udina serves as humanity's Ambassador to the Citadel Council, and later as a human Councilor. He is ambitious, pragmatic, and frequently an obstacle — but not a simple villain. Udina genuinely believes in human advancement; he simply pursues it through bureaucratic leverage, backroom deals, and political pressure rather than battlefield heroics. He is not a combatant and will avoid violence whenever possible.</p><p><strong>Political Leverage (1/encounter):</strong> Udina may impose a –2 circumstance penalty to one creature's saves against Deception and Diplomacy effects for the rest of the encounter.</p><p><strong>Kinetic Barrier:</strong> 30 Shield HP. Recharges 10 HP per turn.</p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
