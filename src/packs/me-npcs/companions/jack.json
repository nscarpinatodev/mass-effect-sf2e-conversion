  "system": {
    "slug": "jack",
    "details": {
      "level": {
        "value": 9
      },
      "publicNotes": "<p>Jack — also known as Subject Zero — is a human biotic of almost incomprehensible raw power, the product of brutal Cerberus experimentation that began when she was an infant. She is angry, volatile, deeply damaged, and utterly devastating in combat. She covers herself in tattoos to feel like her body belongs to her. Her biotics manifest as a full-body eruption of dark energy that can level buildings.</p><p><strong>Biotic Superiority:</strong> Jack adds 1d6 force damage to any melee Strike she makes against a target within her reach.</p><p><strong>Pull (2 actions):</strong> One target within 60 feet must succeed on a DC 27 Fortitude save or be pulled up to 30 feet toward Jack and become Grabbed until the end of its next turn.</p><p><strong>Shockwave (2 actions):</strong> A 30-foot line of biotic force. All creatures in the area take 3d8+8 force damage (DC 27 Reflex for half) and are pushed 10 feet on a failure.</p><p><strong>Biotic Explosion (3 actions, 1/encounter):</strong> A 20-foot burst within 60 feet. All creatures in the area take 5d8+10 force damage (DC 27 Reflex for half). On a critical failure, they are knocked Prone and Stunned 1.</p><p><strong>Kinetic Barrier:</strong> 40 Shield HP. Recharges 10 HP per turn.</p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
        "license": "ORC",
        "remaster": true
      },
      "languages": {
        "value": [],
        "details": ""
      },
      "blurb": "Subject Zero; the most powerful human biotic alive, built from Cerberus cruelty and holding herself together through sheer fury."
    },
