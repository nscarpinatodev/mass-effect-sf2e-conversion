    {
      "_id": "thanea0000000003",
      "name": "Throw (NPC)",
      "type": "action",
      "img": "icons/magic/movement/arrow-up-from-portal.webp",
      "effects": [],
      "flags": {},
      "ownership": {
        "default": 0
