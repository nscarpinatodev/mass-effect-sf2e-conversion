  "system": {
    "slug": "thane-krios",
    "details": {
      "level": {
        "value": 10
      },
      "publicNotes": "<p>Thane Krios is a drell assassin widely regarded as the most skilled in the galaxy. Terminally ill with Kepral's Syndrome, he has come to Shepard seeking a final purpose. He is a man of deep spirituality and profound regret. In combat he is a ghost — positioned before enemies know he is there, delivering devastating sniper shots before they can react. He is also a capable biotic.</p><p><strong>Drell Precision:</strong> Thane deals an additional 2d6 precision damage when striking a flat-footed target.</p><p><strong>Perfect Aim:</strong> Thane ignores the volley penalty on his sniper rifle.</p><p><strong>Biotic Throw (2 actions):</strong> One target within 60 feet must succeed on a DC 28 Fortitude save or be flung 20 feet in a direction of Thane's choice and knocked Prone (taking 2d6 bludgeoning fall damage).</p><p><strong>Serene Focus (free action, 1/encounter):</strong> Thane enters a meditative focus, gaining a +2 circumstance bonus to his next attack roll and ignoring the target's concealment.</p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
        "license": "ORC",
        "remaster": true
      },
      "languages": {
        "value": [],
        "details": ""
      },
      "blurb": "Drell assassin without equal; a terminal illness and a spiritual reckoning don't slow his aim."
