  "system": {
    "slug": "garrus-vakarian",
    "details": {
      "level": {
        "value": 10
      },
      "publicNotes": "<p>Garrus Vakarian is a turian former C-Sec officer and one of Shepard's most loyal companions. Known as Archangel on Omega, he combines the precision of a master sniper with the tactical mind of a trained investigator. He always finds time to calibrate his weapons.</p><p><strong>Turian Training:</strong> Garrus gains a +2 bonus to initiative rolls.</p><p><strong>Calibrations (1/encounter):</strong> Before making an attack roll, Garrus may reroll it and keep the better result.</p><p><strong>Kinetic Barrier:</strong> 50 Shield HP. Recharges 15 HP per turn.</p>",
      "privateNotes": "",
      "publication": {
