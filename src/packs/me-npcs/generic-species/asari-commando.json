    {
      "_id": "NPCAction000002A",
      "name": "Activate Biotic Barrier (NPC)",
      "type": "action",
      "img": "icons/magic/lightning/barrier-shield-crackling-orb-pink.webp",
      "effects": [],
      "flags": {
