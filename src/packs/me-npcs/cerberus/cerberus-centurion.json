  "system": {
    "slug": "cerberus-centurion",
    "details": {
      "level": {
        "value": 4
      },
      "publicNotes": "<p>Cerberus Centurions are squad leaders who coordinate Cerberus forces in the field. They carry a modified M-96 Mattock assault rifle with an underbarrel smoke grenade launcher, which they use to blind and disorient enemies while directing their squad to flanking positions.</p><p><strong>Cerberus Conditioning:</strong> Immune to frightened 1; treats frightened 2+ as frightened 1.</p><p><strong>Tactical Command (free action, 1/round):</strong> One ally within 30 feet gains a +1 circumstance bonus to its next attack roll this round.</p><p><strong>Kinetic Barrier:</strong> 40 Shield HP. Recharges 12 HP per turn.</p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
        "license": "ORC",
        "remaster": true
      },
