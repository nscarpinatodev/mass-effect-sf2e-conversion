  "system": {
    "slug": "cerberus-medic",
    "details": {
      "level": {
        "value": 2
      },
      "publicNotes": "<p>Cerberus Medics are field support personnel trained in combat medicine and omni-tool diagnostics. They keep Cerberus forces operational during prolonged engagements and can stabilize fallen soldiers. While armed with a light pistol, their primary role is support rather than combat.</p><p><strong>Field Triage (2 actions):</strong> The Medic touches an adjacent ally. That ally regains 2d6+4 HP. The Medic can use this ability on themselves.</p><p><strong>Medi-Gel Injection (1 action):</strong> The Medic removes the Dying condition from an adjacent ally and stabilizes them at 1 HP. 1/encounter.</p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
        "license": "ORC",
        "remaster": true
      },
      "languages": {
        "value": [],
        "details": ""
      },
      "blurb": "Cerberus field medic who heals and stabilizes allies during combat."
