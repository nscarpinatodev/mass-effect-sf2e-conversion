  "system": {
    "slug": "cerberus-nemesis",
    "details": {
      "level": {
        "value": 5
      },
      "publicNotes": "<p>Cerberus Nemeses are lightly armored female snipers trained to eliminate high-priority targets at extreme range. They forgo kinetic barriers entirely in favor of mobility and concealment. A Nemesis will reposition after every shot, making them difficult to pin down. Their shots are devastating but telegraphed by a visible laser sight before firing.</p><p><strong>Laser Sight:</strong> Before making a Sniper Shot, the Nemesis designates a target with a visible laser. Allies within 30 feet of the Nemesis can see the laser and warn the target (free action), granting it the Warned condition (+2 circumstance AC vs. that attack) if warned before the shot is resolved.</p><p><strong>Tactical Repositioning (free action, 1/round):</strong> After making a ranged Strike, the Nemesis may Stride up to half her speed as a free action.</p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
        "license": "ORC",
        "remaster": true
      },
      "languages": {
        "value": [],
        "details": ""
      },
      "blurb": "Lightly armored Cerberus sniper who eliminates targets at extreme range with deadly precision."
