  "system": {
    "slug": "cerberus-phantom",
    "details": {
      "level": {
        "value": 8
      },
      "publicNotes": "<p>The Cerberus Phantom is an elite operative enhanced with cybernetics and trained for high-value assassination. She activates a personal phase cloak to approach targets, then strikes with a monomolecular blade and submachine gun. Phantoms are among the deadliest individual combatants in Cerberus's arsenal.</p><p><strong>Phase Cloak (1 action):</strong> The Phantom becomes Invisible until the end of her next turn or until she makes a Strike. While cloaked she gains a +2 circumstance bonus to AC.</p><p><strong>Kinetic Barrier:</strong> 70 Shield HP. Recharges 20 HP per turn.</p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
        "license": "ORC",
        "remaster": true
      },
      "languages": {
        "value": [],
        "details": ""
      },
      "blurb": "Elite Cerberus assassin with phase cloaking, monomolecular blade, and heavy cybernetic augmentation."
