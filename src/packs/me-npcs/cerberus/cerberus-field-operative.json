  "system": {
    "slug": "cerberus-field-operative",
    "details": {
      "level": {
        "value": 5
      },
      "publicNotes": "<p>Cerberus Field Operatives are intelligence agents who operate under civilian cover in Council Space and human colonies. They conduct surveillance, asset recruitment, black site operations, and targeted assassinations. They are skilled at blending in, and when their cover is blown they are capable combatants who fight to extract themselves rather than hold ground.</p><p><strong>Cover Identity:</strong> The Operative's true Cerberus affiliation is not obvious. A Recall Knowledge (Society or Underworld Lore) check of DC 22 is required to identify them as Cerberus without a document check.</p><p><strong>Disappear (reaction):</strong> When targeted by an attack, if the Operative has not yet acted this round, they may attempt a Stealth check (DC 20) to Hide as a reaction. On success, the triggering attack must be rerolled against the Concealed condition.</p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
        "license": "ORC",
        "remaster": true
      },
      "languages": {
        "value": [],
        "details": ""
      },
      "blurb": "Cerberus intelligence agent operating under civilian cover, skilled in espionage and extraction."
