        "actionType": {
          "value": "reaction"
        },
        "actions": {
          "value": null
        },
        "description": {
          "value": "<p><strong>Trigger</strong> The FENRIS is reduced to 0 Hit Points.</p><hr /><p>The chassis dumps its power cell in a <strong>10-foot emanation</strong>. Each creature in the area takes [[/r 2d6[electricity]]] damage with a <strong>DC 17 basic Reflex save</strong>. The FENRIS is destroyed.</p><p>A FENRIS destroyed by an effect that leaves nothing to detonate — disintegration, a critical hit from an electricity effect, or being taken apart while inactive — does not use this reaction.</p>",
          "gm": ""
        },
