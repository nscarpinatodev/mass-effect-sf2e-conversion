  "system": {
    "slug": "engineer-combat-drone",
    "details": {
      "level": {
        "value": 1
      },
      "publicNotes": "<p>A hovering AI drone projected from an Engineer's omni-tool. It harasses enemies and draws their fire.</p><p><strong>Numbers.</strong> Attack: the Engineer's class DC − 10. Damage: 1d6 electricity, with the dice multiplied by level as the Engineer's powers are. AC: class DC − 3. HP: 15 + 5 × the Engineer's level, plus the bonuses of Improved Engineer Mastery and Combat Drone Upgrade. Saves and Perception: class DC − 12.</p><p><strong>In play.</strong> It acts on the Engineer's turn, lasts 1 minute and cannot be healed.</p><p><em>This sheet belongs to an Engineer. Its level, attack, damage, AC, HP and saves are set from the Engineer each time the power is used; the numbers here are for a 1st-level Engineer.</em></p>",
      "privateNotes": "",
      "publication": {
        "title": "Mass Effect Compendium",
        "authors": "nscarpinatodev",
